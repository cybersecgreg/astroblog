---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Spades Scorer — 3 Players" description="Track scores for a 3-player Spades game" />
    <style>
      /* ── Layout ── */
      main {
        width: 900px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 2em 1em 3em;
      }

      h1 { font-size: 2em; margin-bottom: 0.25em; }
      .subtitle { color: rgb(var(--gray)); margin-top: 0; font-size: 0.9em; }

      /* ── Setup screen ── */
      #setup-screen { max-width: 460px; margin: 2em auto; }
      .setup-field { margin-bottom: 1.2em; }
      .setup-field label { display: block; font-weight: 700; margin-bottom: 0.3em; font-size: 0.9em; }
      .setup-field input[type="text"],
      .setup-field input[type="number"] {
        width: 100%;
        padding: 0.45em 0.7em;
        border: 2px solid rgb(var(--gray-light));
        border-radius: 6px;
        font-size: 1em;
        box-sizing: border-box;
        transition: border-color 0.15s;
      }
      .setup-field input:focus { outline: none; border-color: var(--accent); }
      .player-setup-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0.8em;
      }

      /* ── Game screen ── */
      #game-screen { display: none; }

      /* Score board */
      .scoreboard {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1em;
        margin-bottom: 1.5em;
      }
      .score-card {
        background: white;
        border-radius: 12px;
        padding: 1em;
        text-align: center;
        box-shadow: 0 2px 8px rgba(var(--gray), 20%);
        border: 3px solid transparent;
        transition: border-color 0.2s, transform 0.2s;
      }
      .score-card.leader { border-color: #f59e0b; }
      .score-card.eliminated { opacity: 0.55; }
      .player-name {
        font-weight: 700;
        font-size: 1em;
        margin-bottom: 0.2em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .player-score {
        font-size: 2.2em;
        font-weight: 700;
        color: var(--accent);
        line-height: 1.1;
      }
      .player-score.negative { color: #ef4444; }
      .bags-info {
        font-size: 0.75em;
        color: rgb(var(--gray));
        margin-top: 0.25em;
      }
      .round-info {
        text-align: center;
        font-size: 0.85em;
        color: rgb(var(--gray));
        margin-bottom: 1em;
      }

      /* Bid/Tricks entry */
      .entry-section {
        background: white;
        border-radius: 12px;
        padding: 1.5em;
        box-shadow: 0 2px 8px rgba(var(--gray), 20%);
        margin-bottom: 1.5em;
      }
      .entry-section h3 { margin: 0 0 1em; font-size: 1.1em; }
      .entry-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1em;
      }
      .entry-col { display: flex; flex-direction: column; align-items: center; gap: 0.5em; }
      .entry-col .col-label { font-weight: 700; font-size: 0.85em; text-align: center; }
      .entry-col input[type="number"] {
        width: 70px;
        padding: 0.4em 0.3em;
        border: 2px solid rgb(var(--gray-light));
        border-radius: 8px;
        font-size: 1.3em;
        text-align: center;
        transition: border-color 0.15s;
      }
      .entry-col input:focus { outline: none; border-color: var(--accent); }
      .nil-toggle {
        display: flex;
        align-items: center;
        gap: 0.4em;
        font-size: 0.8em;
        cursor: pointer;
        user-select: none;
      }
      .nil-toggle input { width: auto; cursor: pointer; }

      /* Buttons */
      .btn {
        display: inline-block;
        padding: 0.55em 1.4em;
        border: none;
        border-radius: 8px;
        font-size: 0.95em;
        font-weight: 700;
        cursor: pointer;
        transition: opacity 0.15s, transform 0.1s;
      }
      .btn:hover { opacity: 0.88; }
      .btn:active { transform: scale(0.97); }
      .btn-primary { background: var(--accent); color: white; }
      .btn-success { background: #10b981; color: white; }
      .btn-danger  { background: #ef4444; color: white; }
      .btn-ghost   { background: rgb(var(--gray-light)); color: rgb(var(--gray-dark)); }
      .btn-sm      { padding: 0.35em 0.9em; font-size: 0.82em; }

      .actions { display: flex; gap: 0.75em; flex-wrap: wrap; align-items: center; }
      .actions-right { margin-left: auto; }

      /* History table */
      .history-section { margin-top: 1.5em; }
      .history-section h3 { font-size: 1em; margin-bottom: 0.5em; }
      .history-table-wrap { overflow-x: auto; }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82em;
      }
      th, td {
        padding: 0.4em 0.6em;
        text-align: center;
        border-bottom: 1px solid rgb(var(--gray-light));
      }
      th { font-weight: 700; background: rgb(var(--gray-light), 60%); }
      tr:last-child td { border-bottom: none; }
      td.positive { color: #10b981; font-weight: 700; }
      td.negative-val { color: #ef4444; font-weight: 700; }
      td.nil-success { color: #10b981; }
      td.nil-fail { color: #ef4444; }

      /* Win overlay */
      #win-banner {
        display: none;
        background: linear-gradient(135deg, #f59e0b, #ef4444);
        color: white;
        border-radius: 12px;
        padding: 1.5em;
        text-align: center;
        margin-bottom: 1.5em;
      }
      #win-banner h2 { color: white; margin: 0 0 0.3em; font-size: 1.6em; }
      #win-banner p  { margin: 0 0 1em; font-size: 1em; }

      /* Toggle phases */
      .phase { display: none; }
      .phase.active { display: block; }

      @media (max-width: 600px) {
        .scoreboard, .entry-grid { grid-template-columns: 1fr; }
        .player-setup-grid { grid-template-columns: 1fr; }
        .score-card { padding: 0.7em; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>♠ Spades Scorer</h1>
      <p class="subtitle">3-player game &mdash; each player is their own team</p>

      <!-- ══════════════ SETUP ══════════════ -->
      <div id="setup-screen">
        <div class="setup-field">
          <div class="player-setup-grid">
            <div>
              <label for="name0">Player 1 Name</label>
              <input type="text" id="name0" value="Player 1" maxlength="16" />
            </div>
            <div>
              <label for="name1">Player 2 Name</label>
              <input type="text" id="name1" value="Player 2" maxlength="16" />
            </div>
            <div>
              <label for="name2">Player 3 Name</label>
              <input type="text" id="name2" value="Player 3" maxlength="16" />
            </div>
          </div>
        </div>
        <div class="setup-field">
          <label for="target-score">Winning Score</label>
          <input type="number" id="target-score" value="300" min="100" max="2000" step="50" />
        </div>
        <div class="setup-field">
          <label for="bag-penalty-input">Bags Penalty (deduct 100 pts every N bags, 0 = disabled)</label>
          <input type="number" id="bag-penalty-input" value="10" min="0" max="20" step="1" />
        </div>
        <button class="btn btn-primary" id="start-btn">Start Game ♠</button>
      </div>

      <!-- ══════════════ GAME ══════════════ -->
      <div id="game-screen">

        <!-- Win Banner -->
        <div id="win-banner">
          <h2 id="win-msg">🏆 Winner!</h2>
          <p id="win-sub"></p>
          <button class="btn btn-ghost" id="new-game-win-btn">New Game</button>
        </div>

        <!-- Scoreboard -->
        <div class="scoreboard" id="scoreboard">
          <!-- Filled by JS -->
        </div>
        <p class="round-info" id="round-info"></p>

        <!-- Entry form -->
        <div class="entry-section" id="bid-section">
          <h3 id="entry-title">Round 1 — Enter Bids</h3>
          <div class="entry-grid" id="entry-grid">
            <!-- Filled by JS -->
          </div>
          <br />
          <div class="actions">
            <button class="btn btn-primary" id="phase-btn">Submit Bids →</button>
            <button class="btn btn-ghost btn-sm" id="undo-btn" style="display:none">↩ Undo Last Round</button>
            <div class="actions-right">
              <button class="btn btn-ghost btn-sm" id="new-game-btn">New Game</button>
            </div>
          </div>
        </div>

        <!-- History -->
        <div class="history-section" id="history-section" style="display:none">
          <h3>Score History</h3>
          <div class="history-table-wrap">
            <table id="history-table">
              <thead id="history-head"></thead>
              <tbody id="history-body"></tbody>
            </table>
          </div>
        </div>

      </div><!-- /game-screen -->
    </main>
    <Footer />

    <script>
    (() => {
      // ── State ──────────────────────────────────────────────────────────────
      const STORAGE_KEY = 'spades3p_state';

      let state = null; // loaded or created fresh

      // ── DOM refs ───────────────────────────────────────────────────────────
      const setupEl    = document.getElementById('setup-screen');
      const gameEl     = document.getElementById('game-screen');
      const winBanner  = document.getElementById('win-banner');
      const winMsg     = document.getElementById('win-msg');
      const winSub     = document.getElementById('win-sub');
      const scoreboard = document.getElementById('scoreboard');
      const roundInfo  = document.getElementById('round-info');
      const entryTitle = document.getElementById('entry-title');
      const entryGrid  = document.getElementById('entry-grid');
      const phaseBtn   = document.getElementById('phase-btn');
      const undoBtn    = document.getElementById('undo-btn');
      const newGameBtn = document.getElementById('new-game-btn');
      const newGameWin = document.getElementById('new-game-win-btn');
      const histSection= document.getElementById('history-section');
      const histHead   = document.getElementById('history-head');
      const histBody   = document.getElementById('history-body');
      const startBtn   = document.getElementById('start-btn');

      // ── Boot ───────────────────────────────────────────────────────────────
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        try {
          state = JSON.parse(saved);
          showGame();
        } catch { localStorage.removeItem(STORAGE_KEY); }
      }

      // ── Setup ──────────────────────────────────────────────────────────────
      startBtn.addEventListener('click', () => {
        const names = [
          document.getElementById('name0').value.trim() || 'Player 1',
          document.getElementById('name1').value.trim() || 'Player 2',
          document.getElementById('name2').value.trim() || 'Player 3',
        ];
        const target = parseInt(document.getElementById('target-score').value) || 300;
        const bagLimit = parseInt(document.getElementById('bag-penalty-input').value) ?? 10;

        state = {
          names,
          target,
          bagLimit: bagLimit > 0 ? bagLimit : 0,
          scores: [0, 0, 0],
          bags:   [0, 0, 0],
          round:  1,
          phase:  'bid',   // 'bid' | 'tricks'
          bids:   [null, null, null],
          nilBids:[false, false, false],
          history: [],
          gameOver: false,
        };
        save();
        showGame();
      });

      // ── Game UI ────────────────────────────────────────────────────────────
      function showGame() {
        setupEl.style.display = 'none';
        gameEl.style.display  = 'block';
        render();
      }

      function render() {
        renderScoreboard();
        renderEntry();
        renderHistory();
        if (state.gameOver) showWinBanner();
        else winBanner.style.display = 'none';
        undoBtn.style.display = state.history.length > 0 ? 'inline-block' : 'none';
      }

      // ── Scoreboard ─────────────────────────────────────────────────────────
      function renderScoreboard() {
        const maxScore = Math.max(...state.scores);
        scoreboard.innerHTML = state.names.map((name, i) => {
          const score = state.scores[i];
          const bags  = state.bags[i];
          const isLeader = score === maxScore && score > 0;
          return `
            <div class="score-card${isLeader ? ' leader' : ''}">
              <div class="player-name" title="${esc(name)}">${esc(name)}</div>
              <div class="player-score${score < 0 ? ' negative' : ''}">${score}</div>
              <div class="bags-info">
                ${state.bagLimit > 0
                  ? `🎒 ${bags} bag${bags !== 1 ? 's' : ''} (penalty at ${state.bagLimit})`
                  : `🎒 ${bags} bag${bags !== 1 ? 's' : ''}`}
              </div>
            </div>`;
        }).join('');

        roundInfo.textContent = state.gameOver
          ? `Game over! Target was ${state.target} pts.`
          : `Round ${state.round} of ∞ — first to ${state.target} pts wins`;
      }

      // ── Entry form ─────────────────────────────────────────────────────────
      function renderEntry() {
        if (state.gameOver) {
          document.getElementById('bid-section').style.display = 'none';
          return;
        }
        document.getElementById('bid-section').style.display = 'block';

        const isBidPhase = state.phase === 'bid';
        entryTitle.textContent = `Round ${state.round} — ${isBidPhase ? 'Enter Bids' : 'Enter Tricks Taken'}`;
        phaseBtn.textContent   = isBidPhase ? 'Submit Bids →' : '✔ Record Round';

        entryGrid.innerHTML = state.names.map((name, i) => {
          if (isBidPhase) {
            const isNil = state.nilBids[i];
            return `
              <div class="entry-col">
                <div class="col-label">${esc(name)}</div>
                <input type="number" id="input${i}" min="0" max="17"
                       value="${isNil ? 0 : (state.bids[i] ?? 0)}"
                       ${isNil ? 'disabled' : ''}
                       style="opacity:${isNil ? 0.4 : 1}" />
                <label class="nil-toggle">
                  <input type="checkbox" id="nil${i}" ${isNil ? 'checked' : ''} />
                  Nil (0 bid)
                </label>
              </div>`;
          } else {
            const bid = state.nilBids[i] ? 0 : (state.bids[i] ?? 0);
            return `
              <div class="entry-col">
                <div class="col-label">${esc(name)}<br><small style="font-weight:400;color:rgb(var(--gray))">bid: ${state.nilBids[i] ? 'Nil' : bid}</small></div>
                <input type="number" id="input${i}" min="0" max="17" value="0" />
              </div>`;
          }
        }).join('');

        // Wire nil checkboxes
        if (isBidPhase) {
          state.names.forEach((_, i) => {
            const cb  = document.getElementById(`nil${i}`);
            const inp = document.getElementById(`input${i}`);
            cb.addEventListener('change', () => {
              state.nilBids[i] = cb.checked;
              inp.disabled = cb.checked;
              inp.style.opacity = cb.checked ? '0.4' : '1';
              if (cb.checked) inp.value = '0';
            });
          });
        }
      }

      // ── Phase button ───────────────────────────────────────────────────────
      phaseBtn.addEventListener('click', () => {
        if (state.phase === 'bid') {
          // collect bids
          for (let i = 0; i < 3; i++) {
            if (!state.nilBids[i]) {
              const v = parseInt(document.getElementById(`input${i}`).value);
              if (isNaN(v) || v < 0 || v > 17) {
                alert(`${state.names[i]}: bid must be 0–17.`);
                return;
              }
              state.bids[i] = v;
            } else {
              state.bids[i] = 0;
            }
          }
          state.phase = 'tricks';
          save();
          render();
        } else {
          // collect tricks & score
          const tricks = [];
          for (let i = 0; i < 3; i++) {
            const v = parseInt(document.getElementById(`input${i}`).value);
            if (isNaN(v) || v < 0 || v > 17) {
              alert(`${state.names[i]}: tricks must be 0–17.`);
              return;
            }
            tricks.push(v);
          }
          const totalTricks = tricks.reduce((a, b) => a + b, 0);
          if (totalTricks !== 17) {
            alert(`Total tricks must equal 17 (currently ${totalTricks}).`);
            return;
          }
          applyScores(tricks);
        }
      });

      function applyScores(tricks) {
        const deltas   = [0, 0, 0];
        const bagDelta = [0, 0, 0];
        const bagPenalties = [0, 0, 0];

        for (let i = 0; i < 3; i++) {
          const bid = state.bids[i];
          const isNil = state.nilBids[i];
          const t = tricks[i];

          if (isNil) {
            // Nil scoring
            if (t === 0) {
              deltas[i] = 100;   // nil success
            } else {
              deltas[i] = -100;  // nil fail
              // bags from failed nil still count in some rulesets – we add them
              bagDelta[i] = t;
            }
          } else {
            if (t >= bid) {
              const overtricks = t - bid;
              deltas[i] = bid * 10 + overtricks;
              bagDelta[i] = overtricks;
            } else {
              deltas[i] = -(bid * 10);
            }
          }

          // Bag penalty
          if (state.bagLimit > 0 && bagDelta[i] > 0) {
            const newBags = state.bags[i] + bagDelta[i];
            const crossings = Math.floor(newBags / state.bagLimit) - Math.floor(state.bags[i] / state.bagLimit);
            bagPenalties[i] = crossings * 100;
          }
        }

        // Snapshot for history
        const histRow = {
          round:  state.round,
          bids:   [...state.bids],
          nilBids:[...state.nilBids],
          tricks: [...tricks],
          deltas: deltas.map((d, i) => d - bagPenalties[i]),
          scoresBefore: [...state.scores],
          bagsBefore:   [...state.bags],
        };
        state.history.push(histRow);

        // Apply
        for (let i = 0; i < 3; i++) {
          state.scores[i] += deltas[i] - bagPenalties[i];
          if (bagDelta[i] > 0) state.bags[i] += bagDelta[i];
          if (state.bagLimit > 0) state.bags[i] = state.bags[i] % state.bagLimit === 0 && bagPenalties[i] > 0
            ? state.bags[i] % state.bagLimit  // reset bags mod
            : state.bags[i];
          // Actually: bags keep accumulating for display, penalty triggers each crossing
          // Let's keep total bags as is (don't reset), just show them
        }

        // Check win (only if score ≥ target AND highest scorer)
        const maxScore = Math.max(...state.scores);
        if (maxScore >= state.target) {
          state.gameOver = true;
        }

        // Reset for next round
        state.phase   = 'bid';
        state.bids    = [null, null, null];
        state.nilBids = [false, false, false];
        if (!state.gameOver) state.round++;

        save();
        render();
      }

      // ── Win banner ─────────────────────────────────────────────────────────
      function showWinBanner() {
        const maxScore = Math.max(...state.scores);
        const winners  = state.names.filter((_, i) => state.scores[i] === maxScore);
        winBanner.style.display = 'block';
        winMsg.textContent = winners.length === 1
          ? `🏆 ${winners[0]} wins!`
          : `🏆 Tie: ${winners.join(' & ')}!`;
        winSub.textContent = `Final scores — ${state.names.map((n, i) => `${n}: ${state.scores[i]}`).join(' · ')}`;
      }

      // ── History ────────────────────────────────────────────────────────────
      function renderHistory() {
        if (state.history.length === 0) {
          histSection.style.display = 'none';
          return;
        }
        histSection.style.display = 'block';

        histHead.innerHTML = `<tr>
          <th>Rnd</th>
          ${state.names.map(n => `<th colspan="3">${esc(n)}</th>`).join('')}
        </tr>
        <tr>
          <th></th>
          ${state.names.map(() => '<th>Bid</th><th>Got</th><th>Δ</th>').join('')}
        </tr>`;

        histBody.innerHTML = [...state.history].reverse().map(row => {
          const cells = row.bids.map((bid, i) => {
            const nil   = row.nilBids[i];
            const t     = row.tricks[i];
            const delta = row.deltas[i];
            const dClass = delta > 0 ? 'positive' : delta < 0 ? 'negative-val' : '';
            return `<td>${nil ? '<em>Nil</em>' : bid}</td><td>${t}</td><td class="${dClass}">${delta > 0 ? '+' : ''}${delta}</td>`;
          }).join('');
          return `<tr><td>${row.round}</td>${cells}</tr>`;
        }).join('');
      }

      // ── Undo ───────────────────────────────────────────────────────────────
      undoBtn.addEventListener('click', () => {
        if (!state.history.length) return;
        if (!confirm('Undo the last completed round?')) return;
        const last = state.history.pop();
        state.scores  = [...last.scoresBefore];
        state.bags    = [...last.bagsBefore];
        state.round   = last.round;
        state.phase   = 'bid';
        state.bids    = [null, null, null];
        state.nilBids = [false, false, false];
        state.gameOver = false;
        save();
        render();
      });

      // ── New game ───────────────────────────────────────────────────────────
      function resetToSetup() {
        localStorage.removeItem(STORAGE_KEY);
        state = null;
        gameEl.style.display  = 'none';
        setupEl.style.display = 'block';
      }
      newGameBtn.addEventListener('click', () => {
        if (!confirm('Start a new game? Current scores will be lost.')) return;
        resetToSetup();
      });
      newGameWin.addEventListener('click', resetToSetup);

      // ── Persist ────────────────────────────────────────────────────────────
      function save() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      }

      // ── Util ───────────────────────────────────────────────────────────────
      function esc(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }
    })();
    </script>
  </body>
</html>
